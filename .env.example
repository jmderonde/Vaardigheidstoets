# Kopieer naar .env (of zet deze variabelen in Render). Lokaal werkt de app zonder deze instellingen.

# Database: laat leeg voor een lokaal SQLite-bestand (data/local.db). In productie: Turso.
TURSO_DATABASE_URL=libsql://<jouw-database>.turso.io
TURSO_AUTH_TOKEN=

# Eerste beheerder (wordt alleen aangemaakt als er nog geen beheerder is)
ADMIN_EMAIL=beheer@example.com
ADMIN_PASSWORD=kies-een-lang-wachtwoord

# Lang willekeurig geheim voor het ondertekenen van sessies (Render genereert dit zelf)
SESSION_SECRET=

# Publieke basis-URL, voor de QR-code en links naar het groot scherm
BASE_URL=https://vaardigheidstoets.onrender.com
